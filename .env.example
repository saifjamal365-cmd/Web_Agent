# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
WA_MODEL=openai/gpt-oss-120b
WA_VISION_MODEL=qwen/qwen3.8-27b

# Local development: SQLite file in data/. Production: PostgreSQL with pgvector.
# DATABASE_URL=postgresql+psycopg://webagent:CHANGE_ME@localhost:5433/webagent
REDIS_URL=redis://localhost:6379/0
# 1 = run tasks inside the API process (no Redis needed, development only)
WA_INLINE=0

# msedge (Windows, uses installed Edge) or chromium (Playwright's own build, used in Docker)
WA_BROWSER_CHANNEL=msedge
WA_HEADLESS=1
WA_MAX_STEPS=40
WA_MAX_SECONDS=600
WA_APPROVAL_TIMEOUT=900

# Comma-separated, empty = any website
WA_ALLOWED_DOMAINS=
WA_BLOCKED_DOMAINS=

# Set to protect the API (send header X-API-Key). The dashboard asks for it once.
WA_API_KEY=

WA_TRACING=1
MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db
WA_PORT=8020

# A task that waits for your answer longer than this (seconds) gives its browser back to other tasks.
WA_PARK_AFTER=30

# Windows desktop apps (UI Automation). On by default on Windows; off in Docker/Linux.
WA_DESKTOP=1
WA_DESKTOP_APPS=notepad,calculator,paint,wordpad,excel,word
# delegate: helper agents per task and their step limit
WA_MAX_HELPERS=4
WA_HELPER_STEPS=20
# Web search. Search sites (DuckDuckGo, Bing, Brave) block automated browsers more and more; without a key the
# agent tries them and ends with Wikipedia's search. A Brave Search API key (free tier at api.search.brave.com)
# makes web_search reliable. Put the real key only in .env, never in code or chat.
# WA_BRAVE_SEARCH_KEY=
# The agent's Edge: the agent works in a visible Edge window with its own profile, where you sign in yourself
# (once). Needed for Google (Gmail, Chat, Drive): Google refuses sign-in in a browser a program started.
# The profile holds your sign-ins for those sites: it is kept outside OneDrive. Open it: scripts\agent_edge.py
WA_AGENT_EDGE=0
# WA_AGENT_EDGE_PORT=9333
# WA_AGENT_EDGE_PROFILE=%LOCALAPPDATA%\WebAgent\edge-profile
# Files (inbox, downloads) and saved logins. Keep data/sessions private: it holds login cookies.
# WA_FILES_DIR=data/files
# WA_SESSIONS_DIR=data/sessions
